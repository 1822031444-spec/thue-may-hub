PORT=8787
ADMIN_EMAIL=admin@thuemay.local
ADMIN_INITIAL_PASSWORD=Admin@123
SESSION_DAYS=7
CUSTOMER_SESSION_DAYS=14
DATABASE_PATH=./data/thue-may.db

# Chỉ dùng cho lệnh "npm run supabase:push": đưa cấu trúc và dữ liệu mẫu lên Supabase
# để làm báo cáo. App vẫn chạy bằng SQLite, không cần biến này.
# Lấy ở Supabase: mở project → nút Connect → Direct → chọn "Session pooler" → copy chuỗi,
# thay [YOUR-PASSWORD] bằng mật khẩu database (bỏ cả dấu ngoặc vuông).
# Điền vào file .env (không phải file này): .env không bao giờ lên GitHub.
DATABASE_URL=postgresql://postgres.<project-ref>:<mat-khau-database>@aws-0-<vung>.pooler.supabase.com:5432/postgres
